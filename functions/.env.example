# Configuración no secreta de Supabase para Cloud Functions.
# Copia este archivo a functions/.env y reemplaza el valor por tu URL real.
SUPABASE_URL=https://<project-ref>.supabase.co

# SUPABASE_SERVICE_ROLE_KEY es un secreto: NO va en este archivo ni en .env.
# Para desplegar, guárdalo en Firebase Secret Manager con:
# npx firebase-tools functions:secrets:set SUPABASE_SERVICE_ROLE_KEY --project al-toque-delivery
# Para el emulador local, usa functions/.secret.local (ignorado por Git):
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
